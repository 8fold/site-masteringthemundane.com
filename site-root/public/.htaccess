# Handle errors
ErrorDocument 404 /error-404.php
ErrorDocument 405 /error-405.php
ErrorDocument 500 /error-500.html

<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#\.(css|js|woff2)$# && %{QUERY_STRING} =~ /(^|&)v=[0-9a-f]+(&|$)/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#\.(css|js|woff2)$#">
        Header set Cache-Control "no-cache"
    </ElseIf>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Preserve published asset URLs, including query strings on cached CSS.
    RewriteRule ^(css|ui|media|fonts)/(.*)$ /assets/$1/$2 [R=301,L]

    # Published resources have one canonical location; redirect before slash handling.
    RewriteRule ^(?:articles|tools-and-resources)(?:/index\.php)?/?$ /resources/ [R=301,L]
    RewriteRule ^articles/the-action-loop(?:/index\.php)?/?$ /resources/the-action-loop/ [R=301,L]
    RewriteRule ^tools-and-resources/(motivators|the-5-ps)(?:/index\.php)?/?$ /resources/$1/ [R=301,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

	# Always remove www
	RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
	RewriteRule ^(.*)$ http://%1%{REQUEST_URI} [R=301,QSA,NC,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

	# Handle redirects
	Redirect 301 /booking/ /coaching-and-mentoring/
	Redirect 301 /booking /coaching-and-mentoring/
	Redirect 301 /time/ /books/
	Redirect 301 /time /books/

    # Send Requests To Front Controller...
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteRule ^ index.php [L]
</IfModule>
