{
  "name": "8fold/site-masteringthemundane.com",
  "type": "project",
  "description": "The Mastering the Mundane coaching and publishing website.",
  "license": "mixed",
  "authors": [
    {
      "name": "Josh Bruce",
      "email": "josh@8fold.pro",
      "homepage": "https://joshbruce.com",
      "role": "Lead Developer"
    }
  ],
  "support": {
  },
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "8fold/php-html-builder": "^5.0"
  },
  "require-dev": {
    "ext-uri": "*",
    "8fold/commonmark-fluent-markdown": "^1.2",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "MTM\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MTM\\Tests\\": "tests/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "prefer-stable": true,
  "scripts": {
    "prod": "@production",
    "production": [
      "composer dumpautoload -o",
      "@check-content",
      "@style",
      "@stan",
      "@test"
    ],
    "deploy": [
      "@production",
      "@optimize-autoload"
    ],
    "style": "./vendor/bin/phpcs --standard=phpcs.xml",
    "stan": "./vendor/bin/phpstan analyze",
    "test": "./vendor/bin/phpunit",
    "compile-content": "@php cli/compile-content.php",
    "check-content": "@php cli/compile-content.php --check",
    "optimize-autoload": "composer dumpautoload --no-dev --classmap-authoritative"
  }
}
